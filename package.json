{
  "name": "bb-plugin-hermes",
  "version": "0.0.0",
  "private": true,
  "description": "Hermes Agent chats as bb threads.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.49.0",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Hermes [Experimental]",
    "description": "Chat with your Hermes bots in bb, and see their Hermes chats as bb threads.",
    "branding": {
      "icon": "./assets/hermes.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types:check": "node scripts/bb.mjs plugin types --check .",
    "build": "node scripts/bb.mjs plugin build .",
    "check": "npm run test && npm run typecheck && npm run types:check && npm run build",
    "check:private": "node scripts/check-private.mjs"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.49.0",
    "better-sqlite3": "^12.0.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "better-sqlite3@12.11.1": true
  }
}
