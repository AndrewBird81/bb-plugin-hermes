  "cards": [
    {
      "dot": "emerald",
      "title": "On grants",
      "items": [
        "Chat with the bot in bb; its Bot Chat is a pinned bb thread. All its outside chats mirror into bb.",
        "Full access to operate bb: the bot's plugin-owned bb skill calls the bb-hermes wrapper, which runs the bb CLI. Restrictions come later."
      ]
    },
    {
      "dot": "cyan",
      "title": "What the worker writes",
      "items": [
        "One wrapper per Hermes machine: <plugin data>/bin/bb-hermes. It sets BB_SERVER_URL only when the bb server is remote.",
        "One bb skill per enabled bot: <profile>/skills/bb-plugin-hermes/, with a marker file. No config.yaml or .env edit, no Hermes restart."
      ]
    },
    {
      "dot": "slate",
      "title": "Off means",
      "items": [
        "No chat, no mirroring, no bb access. The worker deletes that bot's skill; the wrapper goes once no bot is on. A bot's own bb skills stay untouched.",
        "Every bot starts off (proposed default, Q22)."
      ]
    },
    {
      "dot": "amber",
      "title": "Open items",
      "items": [
        "To be decided in the plan rewrite: whether switching a bot on later imports its last 30 days, and what happens to its bb threads when switched off."
      ]
    }
  ]
