  "cards": [
    {
      "dot": "emerald",
      "title": "Main path",
      "items": [
        "You type in bb. The bb server hands the turn to that chat's bridge on the Hermes machine.",
        "The bridge sends it into the gateway queue (prompt.submit over gateway.sock, hermes-gateway-v1). A bot runs it; the reply streams back the same way."
      ]
    },
    {
      "dot": "cyan",
      "title": "Plugin parts",
      "items": [
        "Server part (bb server): settings and one switch per bot. It never touches Hermes files.",
        "Host worker: one per Hermes machine, with its own gateway.sock connection. It notices changes and runs the 30-day import.",
        "Bridge: one process per open chat, started by bb's host daemon, with its own gateway.sock connection."
      ]
    },
    {
      "dot": "amber",
      "title": "Open item",
      "items": [
        "How the worker reads saved chats (for the import and Conduit's turns): to be decided in the plan rewrite. D40 predates full mirroring.",
        "Everything here is proposed (Q22). The bb server and the Hermes machine can be one computer."
      ]
    }
  ]
