  "cards": [
    {
      "dot": "emerald",
      "title": "Send and stream",
      "items": [
        "Left column is bb (app and server); right column is the Hermes machine (plugin bridge, gateway, bot).",
        "You pick a bot, a model and a reasoning level; the bot stays fixed for the chat. A side chat's first message creates its Hermes chat (session.create); a bot thread uses the bot's Bot Chat. Each message is one prompt.submit with its own submission_id, never resent.",
        "The reply arrives as message.delta and tool events. Steer and attachments also work."
      ]
    },
    {
      "dot": "rose",
      "title": "Approvals and questions",
      "items": [
        "approval.request and clarify.request become a bb card with Hermes' choices and deadline, and send a push.",
        "Your choice goes back as approval.respond or clarify.respond. bb never approves for you."
      ]
    }
  ]
