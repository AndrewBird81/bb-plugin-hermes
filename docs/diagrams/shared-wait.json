  "cards": [
    {
      "dot": "amber",
      "title": "Wait, never fork",
      "items": [
        "\"Refused\" is runtime_coordination_required: Conduit holds a chat the gateway hasn't adopted yet.",
        "bb keeps your message queued and shows \"Open in Conduit: sends when it's free\". It retries at 2, 5, 10 and 30 s, then every 60 s. Stop drops the wait.",
        "Conduit lets go of a Bot Chat when it disconnects, and of other chats after 60 s idle.",
        "bb never creates a second chat and never takes over. After the gateway adopts the chat, Conduit keeps working."
      ]
    }
  ]
