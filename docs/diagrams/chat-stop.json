  "cards": [
    {
      "dot": "orange",
      "title": "bb can stop",
      "items": [
        "bb's own running turn: interrupted (session.interrupt). Queued, or waiting for Conduit: dropped before it reaches Hermes.",
        "A Conduit message forwarded into the gateway queue: interrupted, fenced by its generation."
      ]
    },
    {
      "dot": "slate",
      "title": "bb can't stop",
      "items": [
        "A turn Conduit's dashboard runs itself, and CLI, TUI or Desktop turns. bb stops watching and shows \"Running in <app>\", e.g. \"Running in Conduit\" or \"Running in CLI\" (D27 narrowed).",
        "The turn keeps running in Hermes; its reply still shows in bb when it ends."
      ]
    }
  ]
